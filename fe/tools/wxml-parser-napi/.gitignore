# Native artifacts (D-WX-7 / D-WX-9) — produced by `pnpm build`
*.node
# CLI generated type defs (regenerated by pnpm build; P1 keeps d.ts out of main pkg files)
index.d.ts
# Platform binary payloads inside npm dirs (CI artifacts fill these at release;
# template package.json files stay tracked)
npm/*/index.*.node
